# AUV (CUAV V6X v2, ArduSub 4.7.0 beta) taban parametreleri
# QGC > Vehicle Setup > Parameters > Tools > Load from file ile yuklenir.
# NOT: Bu dosya BASLANGIC noktasidir; kalibrasyonlar (pusula, ivmeolcer,
# joystick) QGC'den ayrica yapilmali, sonra tam dump alinip bu klasore
# auv_v6x_YYYYAAGG.param olarak kaydedilmelidir (her havuz gunu!).
#
# CANLI DUMP KAYNAK: ardusub_params/auv_v6x_20260727.param (1112 param, ethernet .20).
# DONANIM DENETIMI 2026-07-27 (Faz 1) — bu dosya FC'ye TAM YUKLENMEMISTI, uyumsuzluklar:
#  * 4.7 PARAM RENAME: SYSID_THISMAV->MAV_SYSID, GPS_TYPE->GPS1_TYPE (eski isimler
#    QGC "Load from file"da yok sayilir!). Asagida yeni isimler kullanildi.
#  * Ping sonar SERIAL2 DEGIL SERIAL1'de (canli FC: SERIAL1_PROTOCOL=9). Duzeltildi.
#  * GPS1_TYPE canli=9 (baseline 1/AUTO degil) -> catida GPS ile DOGRULA.
#  * BATT_MONITOR=0 (tezgah, batarya yok) + ARMING_SKIPCHK=16776767 (cogu arming
#    kontrolu atlanmis, tezgah kolayligi) -> GERCEK OPERASYON ONCESI gozden gecir.
#  * NET_ (ethernet) params FC'de mevcut (bkz config/mavlink-router/main-ethernet.conf).

# --- Kimlik / cerceve ---
MAV_SYSID,1             # (4.7: eski SYSID_THISMAV). AUV=1. Mini ROV=2 olmali (bkz KARAR #7)
FRAME_CONFIG,2          # Vectored_6DOF (8 motor, BlueROV2-Heavy yerlesimi)
                        # QGC motor diyagramiyla DOGRULANDI:
                        #   1,2 (on) + 3,4 (arka) = yatay vektorel (capraz ikon)
                        #   5,6 (on) + 7,8 (arka) = dikey (dairesel ikon)
                        # Yesil/mavi renkler pervane donus yonunu (CW/CCW) gosterir.

# --- Ping Sonar (TELEM1 = SERIAL1) ---
# DUZELTILDI 2026-07-27: canli FC Ping'i SERIAL1'de tutuyor (SERIAL1_PROTOCOL=9),
# SERIAL2 degil. Onceki "SERIAL2" degeri sablon hatasiydi; DURUM-DEVAM'daki
# "TELEM1/SERIAL1" dogruymus. Bkz KARAR-GECMISI.md #4.
SERIAL1_PROTOCOL,9      # Lidar/Rangefinder
SERIAL1_BAUD,115
RNGFND1_TYPE,23         # BlueRoboticsPing (Ping firmware >= 3.28!)
RNGFND1_ORIENT,25       # asagi bakis
RNGFND1_MIN,0.3
RNGFND1_MAX,30

# --- GNSS (Helical FP9, GPS1 = SERIAL3) ---
GPS1_TYPE,1             # (4.7: eski GPS_TYPE). AUTO; canli FC=9 -> CATIDA DOGRULA

# --- Bar30 ---
# Harici I2C'de MS5837 normalde otomatik algilanir (SCALED_PRESSURE2 kontrol).
# Algilanmazsa acin:
# BARO_PROBE_EXT,512    # MS5837 biti (firmware surumunde dogrulayin)
# Su tipi QGC "Frame" sayfasindan da secilebilir (tatli/tuzlu su).

# --- Failsafe'ler ---
FS_PILOT_INPUT,1        # pilot girdisi kesilirse: uyar (otonom gorevde koprumuz
                        # 10 Hz notr gonderdigi icin tetiklenmez)
FS_PILOT_TIMEOUT,3.0
FS_GCS_ENABLE,0         # Gorev 2'de kablo sokulecegi icin GCS failsafe KAPALI
                        # (guvenlik: gorev betigi zaman asimlarina sahip)
FS_PRESS_ENABLE,1       # derinlik limiti asilirsa uyar
FS_PRESS_MAX,180000     # ~18 m (Pa cinsinden gosterge; QGC'den dogrulayin)
FS_BATT_ENABLE,2        # dusuk bataryada yuzeye
FS_LEAK_ENABLE,2        # sizinti sensoru takilirsa: yuzeye (HEDEF deger)
                        # NOT: Bu dosya FC'ye yuklenene dek FC'de 1 (warn-only) okunabilir
                        # (2026-07-16 saha okumasi). Celisqi degil: hedef<->canli farki.
                        # Ayrica tek basina yetmez; LEAK1_PIN tanimli olmali (bkz asagi).
                        # Bkz docs/KARAR-GECMISI.md #2.
ARMING_CHECK,1

# --- Sizinti (Leak) sensoru — AUX1 sinyal, CUAV V6X ---
# ONEMLI: FS_LEAK_ENABLE=2 tek basina YETMEZ; sensorun OKUNDUGU pin tanimlanmali.
# Tanimli degilse ArduSub hic "Leak Detected" yollamaz -> kokpitte sizdirmazlik
# hep "izleniyor/—" kalir (fiili tespit olmaz). ArduSub yalniz sizinti ANINDA
# STATUSTEXT ("Leak Detected") yollar; surekli "kuru" sinyali YOKTUR.
# Asagidakileri ARAÇTA (QGC) DOGRULAYIP acin:
# LEAK1_PIN,<aux1_gpio_no>   # AUX1'in GPIO pin no'su. QGC > Parameters > LEAK1_PIN
#                            # aciklamasindaki pin listesinden CUAV V6X/AUX1 degerini al.
#                            # AUX1'i cikis yerine GPIO yapmak icin ilgili SERVOx_FUNCTION=0
#                            # (Disabled) gerekebilir (araca gore dogrula).
# LEAK1_LOGIC,0              # Kuru durumdaki mantik seviyesi. Blue Robotics SOS leak:
#                            # tipik kuru=LOW -> 0. Sensorun islakta verdigi seviyeyi dogrula.
# KABUL TESTI (tezgah): leak probunu isla -> QGC'de "Leak Detected" gorulmeli VE
# kokpit header "⚠ SIZINTI" (mandalli) yanmalidir.

# --- Ic/kart sicaklik sensoru — ADC analog, CUAV V6X ---
# Bar30 SU sicakligindan (SCALED_PRESSURE2) AYRI, ADC portundaki analog sensor.
# Kokpit header AUV sicaklik cipini + 90C asim uyarisini besler (/mav/board_temp).
# Asagidakileri ARAÇTA (QGC) DOGRULAYIP acin:
# TEMP1_TYPE,5               # Analog
# TEMP1_PIN,<adc_pin_no>     # CUAV V6X ADC pin no'su. QGC > TEMP1_PIN aciklamasi pin listesi verir.
# TEMP1_A0 .. TEMP1_A4       # Sensor datasheet'ine gore volt->°C polinom katsayilari
#                            # (deg = a0 + a1*V + a2*V^2 + a3*V^3 + a4*V^4).
# TEMP1_SRC,<kaynak>         # Okumanin MAVLink'e cikmasi icin GEREKLI (varsayilan sadece loglar).
#                            # Kopru SCALED_PRESSURE3.temperature rotasini okur. Sensoru isit,
#                            # QGC MAVLink Inspector'da HANGI mesaj/alanin degistigini DOGRULA;
#                            # SCALED_PRESSURE3 degilse bridge_node.py h_pressure3'u o mesaja gore guncelle.

# --- Pusula / EKF notlari ---
COMPASS_AUTODEC,1
# CompassMot (motor girisim kalibrasyonu) havuz varilinde QGC'den yapilacak.
# EKF su altinda GPS'siz calisir; konum tutma beklemeyin (DR Jetson'da).

# --- Motorlar ---
# Motor sirasi/yonu QGC Motor Setup sayfasindan test edilir;
# ters donenler MOT_x_DIRECTION=-1 ile duzeltilir (kablo degistirmeyin).
