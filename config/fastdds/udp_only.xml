<?xml version="1.0" encoding="UTF-8"?>
<!-- FastDDS UDP-only profili. ZED Docker konteynerinden host'a topic'ler SHM ile GEÇMEZ
     (paylaşımlı bellek sınırı); UDP-only ile geçer. auv_stack_start.sh bunu
     FASTRTPS_DEFAULT_PROFILES_FILE ile yükler. -->
<dds xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <profiles>
    <transport_descriptors>
      <transport_descriptor>
        <transport_id>udp_tr</transport_id>
        <type>UDPv4</type>
      </transport_descriptor>
    </transport_descriptors>
    <participant profile_name="udp_only" is_default_profile="true">
      <rtps>
        <userTransports>
          <transport_id>udp_tr</transport_id>
        </userTransports>
        <useBuiltinTransports>false</useBuiltinTransports>
      </rtps>
    </participant>
  </profiles>
</dds>
